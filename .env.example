# ==============================================================================
# Cortex AI Decision Engine - Environment Configuration
# Copy this file to .env and adjust the values as needed.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME="Cortex AI Decision Engine"
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORTEX_API_KEY=cortex-dev-api-key-change-in-production

# CORS Configuration (Comma-separated list or ["*"])
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# Strands Decider 2B Settings (Decision Plane Only)
# Note: Strands Decider ONLY makes routing/gating/classification decisions.
STRANDS_DECIDER_ENDPOINT=http://localhost:8080/v1/decide
STRANDS_DECIDER_TIMEOUT_SECONDS=5.0
STRANDS_DECIDER_MAX_RETRIES=2
STRANDS_DECIDER_MODEL_NAME=strands-decider-2b
STRANDS_DECIDER_MOCK_MODE=true

# Amazon Bedrock Settings (Generation Plane Only)
# Note: Amazon Bedrock ONLY generates responses based on decisions.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEDROCK_ASSUME_ROLE_ARN=
BEDROCK_DEFAULT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TIMEOUT_SECONDS=30.0
BEDROCK_MAX_RETRIES=3
BEDROCK_MOCK_MODE=true

# Decision Orchestrator & Multi-Agent Settings (Placeholders for upcoming modules)
DECISION_CONFIDENCE_THRESHOLD=0.75
MAX_PARALLEL_DECISION_MODULES=11
BENCHMARKING_ENABLED=true
